# Skopiuj do .env i uzupelnij wartosci. Plik .env jest ignorowany przez git.
SQL_CONNECTION_STRING=Server=<host>;Database=<db>;User Id=<user>;Password=<password>;Encrypt=False;TrustServerCertificate=True;
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Para kluczy RSA (PKCS#1, sam base64 bez naglowkow PEM). Wygeneruj wlasna - patrz README.
JWT_PUBLIC_KEY_PEM=<base64 klucza publicznego>
JWT_PRIVATE_KEY_PEM=<base64 klucza prywatnego>
EMAIL_SERVER=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=<user>
EMAIL_PASSWORD=<password>
EMAIL_SSL=true
# Certyfikat do KSeF (Gateway.Api)
KSEF_CERTIFICATE_PATH=/app/certs/ksef.pfx
KSEF_CERTIFICATE_PASSWORD=<password>
